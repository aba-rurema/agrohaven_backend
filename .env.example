DATABASE_URL=postgresql://agrohaven:agrohaven@localhost:5432/agrohaven?schema=public
TEST_DATABASE_URL=postgresql://agrohaven:agrohaven@localhost:5432/agrohaven_test?schema=public
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
DEVICE_OFFLINE_AFTER_MINUTES=5
# Operator settings. A reading past either value creates an alert. They are not a crop model.
LOW_WATER_PERCENT=20
HIGH_TEMPERATURE_CELSIUS=32
BCRYPT_SALT_ROUNDS=12
ALERT_DEDUPE_MINUTES=60
TIMEZONE=Africa/Kigali
RUN_BACKGROUND_JOBS=true
PASSWORD_RESET_MINUTES=30

# Optional. When these are set, forgot-password sends a real email.
# When they are empty, the reset token is stored but not logged or returned.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
